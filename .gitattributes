# Normalise line endings so this repo behaves the same on Windows, macOS and Linux.
# Without this, a Windows checkout rewrites every file to CRLF and the next contributor on
# another platform sees the whole tree as modified.
* text=auto eol=lf

# Scripts that must keep LF even on Windows or they fail to execute.
gradlew         text eol=lf
*.sh            text eol=lf

# Windows-only scripts keep CRLF.
gradlew.bat     text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
*.ttf           binary
*.otf           binary
*.jar           binary
*.keystore      binary
*.jks           binary
*.apk           binary
*.aab           binary

# Generated by build_runner and not committed, but mark them so a stray one never shows up
# in a diff review.
*.freezed.dart  linguist-generated=true
*.g.dart        linguist-generated=true

# Language stats on the repo page should reflect the app, not the SQL or the Gradle glue.
supabase/**     linguist-language=SQL
android/**      linguist-vendored=true
