<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12: the brand mark on the app surface, matching the Flutter splash that
     replaces it on the first frame. Android 12+ draws its own splash from values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dh_surface" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/dh_gold" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
