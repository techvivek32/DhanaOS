<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces the launch window with the system splash: the adaptive icon (gold mark)
     on the app's own surface colour, instead of the default white. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dh_surface</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
